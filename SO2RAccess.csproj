<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SO2RAccess</AssemblyName>
    <RootNamespace>SO2RAccess</RootNamespace>
  </PropertyGroup>

  <!-- Exclude decompiled and template files from build -->
  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <Compile Remove="templates\**" />
  </ItemGroup>

  <!-- MelonLoader (net6 runtime) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>E:\Program Files\Steam\steamapps\common\STAR OCEAN THE SECOND STORY R\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
