<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SO2RAccess</AssemblyName>
    <RootNamespace>SO2RAccess</RootNamespace>
  </PropertyGroup>

  <!-- Exclude decompiled, template, and offline tooling files from build.
       tools\ holds standalone analysis utilities (e.g. GridAnalysis.cs,
       which audits baked .grid files offline) that must not ship in the
       mod DLL. -->
  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <Compile Remove="templates\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>

  <!-- Pre-recorded traversal maps, compiled into the DLL for release. The mod
       loads these when the user has no recording of their own. To refresh,
       copy UserData\SO2RAccess\traversals\*.json into the project's traversals\
       folder and rebuild. -->
  <ItemGroup>
    <EmbeddedResource Include="traversals\*.json" />
  </ItemGroup>

  <!-- World map walkability grids (gzip-compressed), compiled into the DLL
       for release and auto-extracted to UserData\SO2RAccess on first run.
       To refresh after an F9 rebake: gzip UserData\SO2RAccess\worldmap_*.grid
       into the project's grids\ folder and rebuild. A grid already present
       in UserData is never overwritten by the embedded copy. -->
  <ItemGroup>
    <EmbeddedResource Include="grids\*.grid.gz" />
  </ItemGroup>

  <!-- MelonLoader (net6 runtime) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>E:\Program Files\Steam\steamapps\common\STAR OCEAN THE SECOND STORY R\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>E:\Program Files\Steam\steamapps\common\STAR OCEAN THE SECOND STORY R\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>E:\Program Files\Steam\steamapps\common\STAR OCEAN THE SECOND STORY R\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- IL2CPP mscorlib (required for IL2CPP core types) -->
  <ItemGroup>
