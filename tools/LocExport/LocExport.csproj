<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-time throwaway tool: exports the strings from Loc.cs to lang\en.json.
       Compiles Loc.cs itself so the C# compiler parses every string literal
       byte-exactly (escapes, multi-line concatenation). Deleted once Loc.cs
       no longer contains InitializeStrings(). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LocExport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Loc.cs" />
  </ItemGroup>

  <!-- Loc.cs mentions MelonLogger in one catch block, so the compiler needs the reference. -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>E:\Program Files\Steam\steamapps\common\STAR OCEAN THE SECOND STORY R\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
